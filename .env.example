# Copy to .env and fill in. Every value here is optional for local development —
# the defaults in the code are chosen so that `docker compose up -d db` plus
# `./run.sh` works with no .env file at all.
#
# On Render these are set in render.yaml / the dashboard instead; .env is
# gitignored and never shipped in the image (.dockerignore).

# --- Database ---
# Default matches docker-compose.yml. Render injects its own value.
DATABASE_URL=postgresql+asyncpg://marina:marina@localhost:5432/marina
# auto | require | disable. "auto" enables TLS only for external Render hosts.
DATABASE_SSL=auto

# --- Auth ---
# REQUIRED in production: the app refuses to boot on Render without it, because
# otherwise every container start would mint a new random secret and silently
# invalidate every issued token. Locally it is optional — a .jwt_secret file is
# generated on first use instead. The environment always wins over that file.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated origins of the frontend. In production this is the Netlify URL.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
APP_ENV=development

# --- OpenRouter ---
# Read from the environment first; falls back to ~/.config/fabric/.env locally.
OPENROUTER_API_KEY=
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1

# --- Fabric ---
FABRIC_BIN=fabric
FABRIC_MODEL=deepseek/deepseek-v4-flash
FABRIC_VENDOR=OpenRouter
FABRIC_TIMEOUT=600
FABRIC_MAX_RETRIES=3
FABRIC_RETRY_BASE_DELAY=2.0
# Where fabric keeps its config. Patterns resolve from
# $FABRIC_CONFIG_DIR/patterns in this app's own lookups; the fabric binary itself
# only ever reads $HOME/.config/fabric.
FABRIC_CONFIG_DIR=~/.config/fabric

# --- Transcription ---
TRANSCRIPTION_MODEL=openai/gpt-audio-mini
TRANSCRIPTION_CHUNK_SECONDS=600

# --- Rumble ---
RUMBLE_CHANNEL=MarinaJacobi
RUMBLE_CHANNEL_URL=https://rumble.com/c/MarinaJacobi
CHANNEL_MAX_RESULTS=500
CHANNEL_BATCH_SIZE=3
CHANNEL_REFRESH_INTERVAL=3600
# Ceiling on a direct media download, in MB. Video URLs are streamed through
# ffmpeg instead of being written to disk; this bounds the fallback path.
RUMBLE_MAX_DOWNLOAD_MB=1500

# --- Runtime ---
# Scratch space for audio extraction. Wiped at startup, since the per-job cleanup
# cannot run when a container is SIGKILLed (which is what happens on every deploy).
MARINA_TMP_DIR=/tmp/marina
# The app is single-process by design; see main.py._assert_single_process.
SWEEP_STUCK_JOBS_ON_BOOT=1
STUCK_JOB_MAX_AGE_SECONDS=3600
TIKTOKEN_CACHE_DIR=/opt/tiktoken
